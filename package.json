{
  "name": "budget-visualizer-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "analyze:bundle": "ANALYZE=true bun run build",
    "test": "TZ=America/New_York vitest run",
    "test:watch": "TZ=America/New_York vitest",
    "test:coverage": "TZ=America/New_York vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "bun run test && bun run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepush": "bun run lint && bun run format:check && bun run typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^2.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/solid-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.2",
    "lucide-solid": "^1.75.0",
    "solid-js": "^1.9.13",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@tanstack/solid-query-devtools": "^5.108.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.20.0",
    "eslint-plugin-storybook": "^10.6.7",
    "jsdom": "^29.1.1",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.3",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "7.1.3",
    "storybook": "^10.6.7",
    "storybook-solidjs-vite": "10.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "5.1.1"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
